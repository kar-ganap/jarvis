# Letta
LETTA_BASE_URL=http://localhost:8283

# LLM Providers (set the ones you want to use — model is configured in config/jarvis.yaml)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Slack (Phase 3)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Google OAuth (Phase 5)
# Path to the OAuth token file (generated by scripts/setup_google_oauth.py)
GOOGLE_TOKEN_PATH=google_token.json

# Web Search (Phase 2)
TAVILY_API_KEY=

# Internal HTTP bridge (Phase 4)
JARVIS_HTTP_HOST=host.docker.internal
JARVIS_HTTP_PORT=9100

# Notion (Phase 7)
# NOTION_API_KEY=
